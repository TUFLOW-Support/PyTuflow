{
  "hpc_control_files": {
    "description": "Insert after the last command in the control files section. Any new control file command is placed at the bottom of the existing control file commands group.",
    "rule": "after",
    "commands": [
      "Geometry Control File",
      "BC Control File",
      "BC Database",
      "Read Materials File",
      "Estry Control File",
      "Read Soils File",
      "Quadtree Control File",
      "AD Control File",
      "Rainfall Control File"
    ]
  },
  "hpc_solution_scheme": {
    "description": "Insert after the last command in the solution scheme/hardware section.",
    "rule": "after",
    "commands": [
      "solution scheme",
      "hardware"
    ]
  },
  "map_outputs": {
    "description": "Insert after all the map output commands.",
    "rule": "after",
    "commands": [
      "map output"
    ]
  },
  "fvc_output": {
    "description": "Insert after all the fv output blocks.",
    "rule": "after",
    "commands": [
      "Output Dir",
      "Log Dir",
      "Write Check Files",
      "/^output$/i"
    ]
  },
  "before_fvc_output": {
    "description": "Insert before all the fv output blocks.",
    "rule": "before",
    "commands": [
      "Output Dir",
      "Log Dir",
      "Write Check Files",
      "/^output$/i"
    ]
  },
  "fvc_structures": {
    "description": "Insert after all the fv structure blocks.",
    "rule": "after",
    "commands": [
      "/^structure$/i"
    ]
  },
  "before_fvc_structures": {
    "description": "Insert before all the fv structure blocks.",
    "rule": "before",
    "commands": [
      "/^structure$/i"
    ]
  },
  "fvc_geometry_2d": {
    "description": "Insert after 2D geometry command(s).",
    "rule": "after",
    "commands": [
      "/^geometry 2d$/i"
    ]
  },
  "fvc_simulation_configuration": {
    "description": "Insert after other simulation configuration commands.",
    "rule": "after",
    "commands": [
      "/^Bottom Drag Model$/i",
      "/^Include Salinity$/i",
      "/^Include Temperature$/i",
      "/^Spatial Order$/i",
      "/^Include Heat$/i",
      "/^Spherical$/i",
      "/^Latitude$/i",
      "/^Ntracer$/i"
    ]
  },
  "fvc_model_parameters": {
    "description": "Insert after model parameter commands.",
    "rule": "after",
    "commands": [
      "! MODEL PARAMETERS",
      "/^Momentum mixing model$/i",
      "/^Global horizontal eddy viscosity$/i",
      "/^Global horizontal eddy viscosity limits$/i",
      "/^Scalar mixing model$/i",
      "/^Global horizontal scalar diffusivity$/i",
      "/^Global horizontal scalar diffusivity limits$/i",
      "/^Cell Wet/Dry Depths$/i",
      "/^Vertical Mixing Model$/i",
      "/^Vertical Mixing Parameters$/i",
      "/^Global Vertical Eddy Viscosity Limits$/i",
      "/^Global Vertical Scalar Diffusivity Limits$/i",
      "/^Global Vertical TKE Limit$/i",
      "/^Global Vertical EPS Limit$/i",
      "/^Second Order Vertical Mixing Model$/i",
      "/^Second Order Vertical Mixing Model Parameter Group$/i"
    ]
  },
  "fv_control_files": {
    "description": "Insert after other fv control files.",
    "rule": "after",
    "commands": [
      "/^sediment control file$/i",
      "/^water quality control file$/i",
      "/^wq control file$/i",
      "/^Water Quality Model Directory$/i",
      "/^WQ Model Directory$/i",
      "/^particle tracking control file/i"
    ]
  },
  "fvc_initial_conditions": {
    "description": "Insert after other initial conditions.",
    "rule": "after",
    "commands": [
      "! INITIAL CONDITIONS",
      "/^Initial Water Level$/i",
      "/^Initial Tracer Concentration$/i",
      "/^Initial Salinity$/i",
      "/^Initial Temperature$/i",
      "/^Initial WQ Concentration$/i",
      "/^Initial Sediment Concentration$/i",
      "/^Initial Condition 2D$/i",
      "/^Initial Condition 3D$/i",
      "/^Initial Condition OGCM$/i",
      "/^Initial Condition Quiescent$/i",
      "/^Initial Scalar Profile$/i"
    ]
  },
  "fvc_tracer_block_heading": {
    "description": "Insert after tracer block heading.",
    "rule": "after",
    "commands": [
      "! TRACER DEFINITION"
    ]
  }
}
