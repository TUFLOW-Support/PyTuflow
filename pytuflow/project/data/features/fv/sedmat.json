{
  "name": "sedmat",
  "display_name": "Sediment Material",
  "sort_order": 5,
  "template_files": [],
  "command_blocks": [
    {
      "id": "fvsed_material",
      "target_cf": "fvsed",
      "placement_rule": "fvsed_material",
      "allow_multiple": true,
      "commands": [
        "Material == ${stm_mat_id}"
      ]
    },
    {
      "id": "fvsed_material_param",
      "target_cf": "fvsed",
      "target_previous_block": true,
      "allow_multiple": true,
      "commands": [
        "Suspended Load Scale == ${stm_suspended_load_scale}",
        "##IF ${stm_mat_nlayers}>1##",
            "Nlayers == ${stm_mat_nlayers}",
        "##ENDIF##",
        "##ITER:${stm_mat_layers}##",
            "Layer == ${stm_mat_layer_id}",
            "##STARTBLOCK##",
            "Dry density == ${stm_mat_layer_dry_density}",
            "##IF not:${stm_mat_layer_initial_mass}:0##",
                "Initial mass == ${stm_mat_layer_initial_mass}",
            "##ENDIF##",
            "##ITER:${stm_mat_layer_fractions}##",
                "Fraction == ${stm_sed_frac_name}",
                "##STARTBLOCK##",
                "##IF not:${stm_settling_model}:0##",
                    "Settling parameters == ${stm_settling_params}",
                "##ENDIF##",
                "##IF not:${stm_deposition_model}:0;ws0##",
                    "Deposition Parameters == ${stm_deposition_params}",
                "##ENDIF##",
                "##IF not:${stm_erosion_model}:0##",
                    "Erosion parameters == ${stm_erosion_params}",
                "##ENDIF##",
                "##IF not:${stm_bed_load_model}:0##",
                    "Bed load parameters == ${stm_bed_load_params}",
                "##ENDIF##",
                "##ENDBLOCK##",
            "##ENDITER##",
            "##ENDBLOCK##",
        "##ENDITER##"
      ]
    }
  ]
}
