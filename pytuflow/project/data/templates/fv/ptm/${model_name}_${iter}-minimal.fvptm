! PTM to assess fate of CSO Outfall

! use nodestring definition from HD model to allow particles to leave model domain. 
Open boundary nodestring == ${ptm_bndry_ns_id}

!_________________________________________________________________
! TIME COMMANDS
lagrangian timestep == ${ptm_lagragian_timestep}                                         ! seconds
eulerian timestep == ${ptm_eulerian_timestep}                                            ! seconds

! Global COMMANDS
Nscalar == ${ptm_nscalar}

! Sediment Transport COMMANDS (required if a particle group interacts with bed)
bed roughness model == ${stm_bed_roughness_model}
bed roughness parameters == ${stm_bed_roughness_params}                                  ! ksc, ksw

! Depth Limit commands
erosion depth limits == ${stm_erosion_dep_lims}                                          ! Analagous to sediment transport
deposition depth limits == ${stm_deposition_dep_lims}                                    ! Analagous to sediment transport

!_________________________________________________________________
! PARTICLE GROUP COMMANDS

!_________________________________________________________________
! MATERIAL SPEC COMMANDS

!_________________________________________________________________
! PARTICLE SEED COMMANDS

!_________________________________________________________________
! OUTPUT SETTINGS
output dir == ..\results\
