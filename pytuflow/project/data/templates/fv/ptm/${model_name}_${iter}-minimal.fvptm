Nscalar == ${ptm_nscalar}

! Sediment Transport COMMANDS (required if a particle group interacts with bed)
bed roughness model == ${stm_bed_roughness_model}
bed roughness parameters == ${stm_bed_roughness_params}

! Depth Limit commands
erosion depth limits == ${stm_erosion_dep_lims}
deposition depth limits == ${stm_deposition_dep_lims}

