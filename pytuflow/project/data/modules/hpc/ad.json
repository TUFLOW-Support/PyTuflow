{
  "name": "ad",
  "display_name": "AD (Advection-Diffusion)",
  "sort_order": 50,
  "template_files": [
    {
      "template_key": "model/${model_name}_${iter}.adcf",
      "output_subdir": "model"
    },
    {
      "template_key": "bc_dbase/bc_dbase_${model_name}_AD.csv",
      "output_subdir": "bc_dbase"
    },
    {
      "template_key": "bc_dbase/${model_name}_AD_Constituents.csv",
      "output_subdir": "bc_dbase"
    }
  ],
  "command_blocks": [
    {
      "id": "ad_tcf",
      "target_cf": "tcf",
      "placement_rule": "hpc_control_files",
      "commands": [
        "AD Control File == ..\\model\\${model_name}_${iter}.adcf"
      ]
    }
  ]
}
